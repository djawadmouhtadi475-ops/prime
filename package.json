{
  "name": "prime-launcher",
  "productName": "Prime Launcher",
  "version": "0.3.9",
  "description": "Prime Launcher — لانشر ماينكرافت عربي من Gmu Studios",
  "author": "Gmu Studios",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/get-fonts.js",
    "make-icons": "node scripts/make-icons.js",
    "prebuild": "node scripts/ensure-keys.js",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.gmustudios.primelauncher",
    "productName": "Prime Launcher",
    "artifactName": "PrimeLauncher-${version}-${os}.${ext}",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "keys.json",
        "to": "keys.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Prime Launcher"
    }
  }
}